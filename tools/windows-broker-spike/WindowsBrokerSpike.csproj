<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>WindowsBrokerSpike</AssemblyName>
  </PropertyGroup>
  <Target Name="RejectShippingBuild" BeforeTargets="CoreCompile" Condition="'$(Configuration)' != 'Debug'">
    <Error Text="M1.5 feasibility harness is non-shipping and Debug-only." />
  </Target>
</Project>
