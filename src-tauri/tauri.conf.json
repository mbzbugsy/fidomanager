{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FidoManager",
  "version": "0.1.0",
  "identifier": "eu.fidomanager.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FidoManager",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; base-uri 'none'; connect-src ipc: http://ipc.localhost; form-action 'none'; frame-ancestors 'none'; img-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
